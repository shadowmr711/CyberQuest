# CyberQuest Environment Configuration
# Copy this file to .env and adjust variables as needed

FLASK_APP=backend/run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=dev-cyberquest-insecure-key-change-in-production-64char-hex
DATABASE_URL=sqlite:///database/cyberquest.db
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
PORT=5000
